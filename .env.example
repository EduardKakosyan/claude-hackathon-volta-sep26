# ---- Data ----------------------------------------------------------------------
# The app has two modes, chosen by whether the two Supabase values are set.
#
#   Fixture day (both unset)   A hand-written, realistic day from lib/fixture/today.ts
#                              plus the seeded replay days in git. No network, no
#                              credentials. This is what a fresh clone, `pnpm e2e`
#                              and CI see; the footer says "Showing a fixture day".
#                              Refused when VERCEL_ENV=production: the page fails
#                              loudly rather than pass a fixture off as live status.
#
#   Live (both set)            Reads and writes the Supabase project. To run locally
#                              against the real data:  vercel env pull .env.local
#
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token /api/refresh requires. Vercel Cron sends it automatically when set.
CRON_SECRET=

# ---- Crowd reports (Phase 5) ------------------------------------------------
# Every value below must be present, and non-test, before production accepts a
# submission. resolveReportsConfig() in lib/reports/config.ts fails closed and
# names the first missing value as its `reason`. The two variables above are
# part of that check: with no database, reports are 'missing-database' while
# the rest of the app still serves the fixture day.

# Master switch. Anything other than exactly "true" disables reports entirely.
REPORTS_ENABLED=false

# Cloudflare Turnstile. The widget's hostname list must include localhost plus
# the preview and production hostnames, and its action must be "report-sign"
# to match TURNSTILE_ACTION in lib/reports/turnstile.ts.
# Cloudflare's always-passes test pair, which is refused in production:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for the stored IP hash. 32+ characters; generate with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing hash, which resets all throttles and
# un-flags every beach. Never commit it; never reuse it across environments.
REPORT_IP_SALT=

# The single proxy header trusted for the client address. One of
# x-real-ip | x-vercel-forwarded-for | x-forwarded-for. Defaults to x-real-ip.
# Only name a header the platform in front of the app overwrites.
REPORT_TRUSTED_IP_HEADER=x-real-ip

# `next dev` sits behind no proxy, so no trusted header arrives and every
# submission would fail with 'no-ip'. This stands in locally and is ignored
# whenever the environment resolves as production.
REPORT_DEV_FALLBACK_IP=127.0.0.1
