# Crowd reports (Phase 5). Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.
#
# Every value below must be present and non-test before production accepts a
# submission. resolveReportsConfig() in lib/reports/config.ts fails closed and
# reports the first missing value as its `reason`.

# Master switch. Anything other than exactly "true" disables reports entirely.
REPORTS_ENABLED=false

# Cloudflare Turnstile. Create a widget at
# https://dash.cloudflare.com → Turnstile, with the deployment hostname(s)
# and localhost for development. The widget's action must be "report-sign".
# Cloudflare's always-passes test pair (rejected in production):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for the stored IP hash. 32+ characters; generate with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing hash, which resets all throttles
# and un-flags every beach. Never commit it and never reuse it across
# environments.
REPORT_IP_SALT=

# The single proxy header trusted for the client address. One of
# x-real-ip | x-vercel-forwarded-for | x-forwarded-for. Defaults to x-real-ip.
# Only set this to a header the platform in front of the app overwrites.
REPORT_TRUSTED_IP_HEADER=x-real-ip

# `next dev` sits behind no proxy, so no trusted header arrives and every
# submission would fail with 'no-ip'. This stands in locally and is ignored
# whenever the environment resolves as production.
REPORT_DEV_FALLBACK_IP=127.0.0.1

# Supabase. The service-role key bypasses RLS — server-side only, never
# NEXT_PUBLIC_. Required for the report store and photo storage adapters.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
